# Скопіюйте цей файл у .env і за потреби змініть значення.
# .env у git не потрапляє (див. .gitignore).

# --- MongoDB (підключення через mongos) ---
MONGO_URL=mongodb://localhost:27017
MONGO_DB=recipes

# --- Elasticsearch ---
ES_URL=http://localhost:9200
ES_INDEX=recipes

# --- Neo4j ---
NEO4J_URL=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- RabbitMQ ---
RABBIT_URL=amqp://guest:guest@localhost:5672/
# Обмінник типу fanout: кожне повідомлення копіюється в три черги запису.
RABBIT_EXCHANGE=recipes
RABBIT_QUEUES=["recipes.mongo","recipes.es","recipes.neo4j"]
RABBIT_MANAGEMENT_URL=http://localhost:15672

# --- ingest-service ---
INGEST_CSV_PATH=data/RAW_recipes.csv
INGEST_DEFAULT_RATE=10
INGEST_TICK_SECONDS=0.1

# --- writer-service ---
# Роль екземпляра: mongo, es або neo4j. Черга екземпляра — recipes.<роль>.
WRITER_ROLE=mongo
WRITER_BATCH_SIZE=500
WRITER_BATCH_TIMEOUT_MS=200
WRITER_PREFETCH_COUNT=1000

# --- query-service ---
SEARCH_CACHE_TTL_SEC=300
